// Production deploy of the docs site (used by the deploy job in ci.yml).
// Paths are relative to this file.
{
  "name": "layout-kit",
  "compatibility_date": "2026-10-30",
  // Static assets only: no Worker script.
  "assets": {
    "directory": "../../out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "layout.csikie.com", "custom_domain": true }],
}
