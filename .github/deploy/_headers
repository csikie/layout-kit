# Cloudflare Workers Static Assets response headers (max 100 rules).
# A full Content-Security-Policy needs a hash for the inline theme script, so
# only frame-ancestors is set for now.

/*
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=()
  Strict-Transport-Security: max-age=63072000

# Registry items: readable from any origin, revalidated after five minutes so a
# new release reaches the shadcn CLI quickly.
/r/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300, must-revalidate

# Content-hashed build assets never change.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
